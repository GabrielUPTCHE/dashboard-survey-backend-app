# Ignorar variables locales o secretos que tú definas
*.tfvars
*.tfvars.json

# Ignorar configuraciones de CLI locales
.terraformrc
terraform.rc

# Ignorar archivos de log
*.log

# Ignorar planes de ejecución guardados (pueden contener secretos en texto plano)
*.tfplan
*.tfplan.json
